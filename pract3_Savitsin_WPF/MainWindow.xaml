<Window x:Class="pract3_Savitsin_WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:pract3_Savitsin_WPF"
        mc:Ignorable="d"
        Title="Публикация объявления" Height="600" Width="800"
        Background="LightBlue">
    <Grid Background="LightBlue" VerticalAlignment="Top">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="475"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Column="0" LastChildFill="True" VerticalAlignment="Top" Background="SlateGray">
            <TextBox Text="Публикация объявления" Background="SlateGray" Margin="10" Foreground="White" BorderBrush="SlateGray" FontSize="17"/>
        </DockPanel>

        <Grid Margin="10" Grid.Row="1" Grid.Column="0" Background="White" Height="450" VerticalAlignment="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="75"/>
                <ColumnDefinition Width="75"/>
                <ColumnDefinition Width="75"/>
                <ColumnDefinition Width="75"/>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="150"/>
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="10"/>
                <RowDefinition Height="30"/>
                <RowDefinition Height="30"/>
                <RowDefinition Height="30"/>
                <RowDefinition Height="30"/>
                <RowDefinition Height="30"/>
                <RowDefinition Height="30"/>
                <RowDefinition Height="30"/>
                <RowDefinition Height="30"/>
                <RowDefinition Height="30"/>
                <RowDefinition Height="30"/>
                <RowDefinition Height="60"/>
                <RowDefinition Height="40"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="1" Grid.Column="0" Margin="10, 5, 5, 5" Text="Заголовок"/>
            <TextBlock Grid.Row="2" Grid.Column="0" Margin="10, 5, 5, 5" Text="Категория"/>
            <TextBlock Grid.Row="3" Grid.Column="0" Margin="10, 5, 5, 5" Text="Состояние"/>
            <TextBlock Grid.Row="4" Grid.Column="0" Margin="10, 5, 5, 5" Text="Цена"/>
            <TextBlock Grid.Row="5" Grid.Column="0" Margin="10, 5, 5, 5" Text="Город"/>

            <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="6" Height="25" x:Name="txtHeadline"/>
            <ComboBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Height="25" Name="comboBoxCategory">
                <ComboBoxItem Content="Электроника"/>
                <ComboBoxItem Content="Косметика" />
                <ComboBoxItem Content="Транспорт" />
            </ComboBox>
            <TextBlock Grid.Row="2" Grid.Column="3" Grid.ColumnSpan="2" Margin="5" Text="Имя продавца"/>
            <TextBox x:Name="txtNameSeller" Grid.Row="2" Grid.Column="5" Grid.ColumnSpan="2" Height="25"/>

            <ComboBox Grid.ColumnSpan="2" Grid.Row="3" Grid.Column="1" Height="25">
                <ComboBoxItem Content="Новое"/>
                <ComboBoxItem Content="Старое"/>
                <ComboBoxItem Content="Требуется ремонт"/>
                <ComboBoxItem Content="Не требуется ремонт"/>
            </ComboBox>
            <TextBlock Text="Телефон" Grid.Row="3" Grid.Column="3" Grid.ColumnSpan="2" Margin="5"/>
            <TextBox Grid.Row="3" Grid.Column="5" Grid.ColumnSpan="2" Height="25"/>

            <TextBox Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Height="25"/>
            <TextBlock Text="Способ связи" Grid.Row="4" Grid.Column="3" Grid.ColumnSpan="2" Margin="5"/>
            <ComboBox Grid.Row="4" Grid.Column="5" Grid.ColumnSpan="2" Height="25">
                <ComboBoxItem Content="Звонок"/>
                <ComboBoxItem Content="Сообщение"/>
                <ComboBoxItem Content="Почта"/>
            </ComboBox>

            <TextBox Grid.ColumnSpan="2" Grid.Row="5" Grid.Column="1" Height="25"/>
            <Border Grid.Row="5" Grid.Column="3" Grid.ColumnSpan="2" Grid.RowSpan="2" Margin="3" BorderBrush="DeepSkyBlue" Width="125" Background="LightBlue" BorderThickness="1">
                <TextBlock Width="80" Text="Главное фото" Foreground="DeepSkyBlue" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="25,0,0,0"/>
            </Border>
            <Button Content="Выбрать фото" Grid.Column="5" Grid.ColumnSpan="2" Grid.Row="5" Height="25"/>

            <TextBlock Text="Описание" Margin="10, 5, 5, 5" Grid.Column="0" Grid.Row="7"/>
            <TextBox Margin="10, 5, 5, 5" Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="7" Grid.RowSpan="2"/>
            <TextBlock Text="Фотографии" Grid.Column="0" Grid.Row="10" FontWeight="Bold" Margin="10, 10, 0, 0"/>

            <WrapPanel Orientation="Vertical" Grid.Row="11" Grid.Column="0" Grid.ColumnSpan="7">
                <Border Margin="10, 10, 0, 0" Height="50" BorderBrush="DeepSkyBlue" Width="110" Background="LightBlue" BorderThickness="1">
                    <TextBlock Width="40" Height="20" Text="Фото 1" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Border>

                <Border Margin="10, 10, 0, 0" Height="50" BorderBrush="DeepSkyBlue" Width="110" Background="LightBlue" BorderThickness="1">
                    <TextBlock Width="40" Height="20" Text="Фото 2" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Border>

                <Border Margin="10, 10, 0, 0" Height="50" BorderBrush="DeepSkyBlue" Width="110" Background="LightBlue" BorderThickness="1">
                    <TextBlock Width="40" Height="20" Text="Фото 3" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Border>

                <Border Margin="10, 10, 0, 0" Height="50" BorderBrush="DeepSkyBlue" Width="110" Background="LightBlue" BorderThickness="1">
                    <TextBlock Width="40" Height="20" Text="Фото 4" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Border>

                <Border Margin="10, 10, 0, 0" Height="50" BorderBrush="DeepSkyBlue" Width="110" Background="LightBlue" BorderThickness="1">
                    <TextBlock Width="40" Height="20" Text="Фото 5" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Border>
            </WrapPanel>

            <Button Grid.Row="11" Grid.Column="6" Margin="10, 10, 0, 0" Height="50" Width="110" Content="Добавить фото"/>
            
            <StackPanel Grid.Column="0" Grid.ColumnSpan="4" Orientation="Horizontal" Margin="10, 10, 10, 10" Grid.Row="12">
                <CheckBox Content="Возможен торг"/>
                <CheckBox Margin="10, 0, 0, 0" Content="Готов отправить"/>
                <CheckBox Margin="10, 0, 0, 0" Content="Только самовывоз"/>
            </StackPanel>
        </Grid>

        <DockPanel VerticalAlignment="Top" Grid.Row="2" HorizontalAlignment="Right">
            <Button Margin="10" Width="140" Content="Сохранить черновик" Height="30"/>
            <Button Margin="0, 10, 10, 10" Width="100" Content="Опубликовать" Height="30"/>
            <Button Margin="0, 10, 10, 10" Width="70" Content="Отмена" Height="30"/>
        </DockPanel>
    </Grid>
</Window>
